{
  "name": "jsonbro.dev",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm install --prefer-offline && vite",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "build": "vite build && cp public/404.html dist/ && cp public/robots.txt dist/ && cp public/sw.js dist/ && cp public/icon.svg dist/ && node scripts/generate-static.mjs",
    "build:prod": "vite build && cp public/404.html dist/ && cp public/robots.txt dist/ && cp public/sw.js dist/ && cp public/icon.svg dist/ && node scripts/generate-static.mjs",
    "lint": "pnpm install --prefer-offline && eslint .",
    "preview": "pnpm install --prefer-offline && vite preview",
    "install-deps": "pnpm install --prefer-offline",
    "clean": "rm -rf node_modules .pnpm-store pnpm-lock.yaml && pnpm store prune",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-switch": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.0.0",
    "hotkeys-js": "4.0.0-beta.6",
    "idb-keyval": "^6.2.2",
    "jsonc-parser": "^3.3.1",
    "jsonrepair": "^3.13.1",
    "lucide-react": "^0.364.0",
    "monaco-editor": "^0.54.0",
    "papaparse": "^5.5.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sonner": "^1.7.2",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@playwright/test": "1.49.1",
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "14.5.2",
    "@types/node": "^22.10.7",
    "@types/papaparse": "^5.5.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/ui": "2.1.9",
    "autoprefixer": "10.4.20",
    "axe-core": "4.10.2",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "fake-indexeddb": "6.0.0",
    "globals": "^15.12.0",
    "jsdom": "25.0.1",
    "postcss": "8.4.49",
    "tailwindcss": "v3.4.16",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.15.0",
    "vite": "^6.0.1",
    "vite-plugin-source-identifier": "1.1.2",
    "vitest": "2.1.9"
  },
  "description": "Keyboard-first JSON editor, formatter, validator, tree browser and diff tool that runs entirely in the browser.",
  "license": "MIT"
}
